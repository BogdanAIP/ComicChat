# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=https://your-app-domain.com

# ── SMTP / Email Notifications (optional) ───────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=Your App Name <your-email@example.com>

# ── Cloudinary – File & Audio Uploads (optional) ────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# ── ComicChat MCP production smoke (operations only; not exposed to browser) ──
COMICCHAT_MCP_URL=https://your-project-id.supabase.co/functions/v1/comicchat-mcp


# PR-25 optional server-side comic renderer.
# Keep this secret only in the Supabase Edge Function environment. Never use
# NEXT_PUBLIC_ for it. External generation also remains disabled in the DB
# until comic_generation_config.external_generation_enabled is explicitly set.
OPENAI_API_KEY=
